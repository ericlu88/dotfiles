[alias]
	## overrides
	grep = grep -I
	## two-letter shortcuts
	br = branch -avv
	ci = commit
	co = checkout
	dc = diff --cached
	st = status
	## log shortcuts
	lg = log --oneline --graph --decorate
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%an]"
	ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%an]" --numstat --decorate
	## remote shortcuts
	ru = remote update
	fp = fetch --prune
	sync = !git fetch --all --prune --prune-tags --force && git pull
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[core]
	## warn on unsafe or irreversable conversions
	safecrlf = warn
[diff]
	## don't show as modified if submodules have untracked files
	ignoreSubmodules = untracked
[merge]
	## a wonderful default diffing tool
	tool = vimdiff
	## provide base context to aid in conflict resolution
	conflictstyle = diff3
[pager]
	## use the pager for long status display
	status = true
[push]
	default = simple
[rerere]
	enabled = true
[include]
	## source local override file if one exists
	path = ~/.dotfiles/local/gitconfig
[credential]
	helper = osxkeychain
[user]
	name = Eric Lu
	email = ericlu88@users.noreply.github.com
[url "https://"]
	insteadOf = git://
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
